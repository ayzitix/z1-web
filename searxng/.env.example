# Copy to searxng/.env (or just run ../scripts/searx-up.sh, which generates it).
#
# SEARXNG_SECRET is the Flask/CSRF signing secret for the instance. Any random
# value works; it must stay private. Generate one with:
#   openssl rand -hex 32
# An empty value makes searx-up.sh generate one and write .env with mode 600.
SEARXNG_SECRET=
